# =============================================================================
# Configuration de l'application QUAI 19 — modèle à copier
# =============================================================================
# 1. Copiez ce fichier sous le nom « .env » (sans « .example »).
# 2. Remplacez les valeurs d'exemple par les vraies.
# 3. Ne partagez JAMAIS le fichier .env (il contient des secrets) : il est
#    automatiquement exclu de Git.

# --- Base de données PostgreSQL ----------------------------------------------
# Adresse de connexion fournie par l'hébergeur (doit être située dans l'UE).
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/quai19?schema=public"

# --- Adresse publique du site -------------------------------------------------
# Utilisée pour construire les liens dans les e-mails.
APP_URL="http://localhost:3000"

# --- Sécurité -----------------------------------------------------------------
# Secret de session du back-office. Générez-le avec : openssl rand -base64 32
AUTH_SECRET="a-remplacer"
# Clé de chiffrement des secrets de double authentification (32 octets en base64).
# Générez-la avec : openssl rand -base64 32
ENCRYPTION_KEY="a-remplacer"
# Secret protégeant le déclenchement des tâches automatiques (rappels, purge RGPD).
CRON_SECRET="a-remplacer"

# --- Envoi des e-mails (SMTP) ---------------------------------------------------
# Par défaut Brevo (France) : https://app.brevo.com > SMTP & API.
# Tout autre prestataire SMTP (hébergé dans l'UE de préférence) fonctionne.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="a-remplacer"
SMTP_PASSWORD="a-remplacer"
# Adresse d'expédition (doit être un domaine vérifié chez le prestataire).
EMAIL_FROM="QUAI 19 <reservation@exemple.fr>"
# Adresse de l'équipe qui reçoit les notifications de nouvelles demandes.
EMAIL_TEAM="equipe@exemple.fr"

# --- Tests automatisés (développement uniquement) ------------------------------
# Base dédiée aux tests : elle est vidée à chaque lancement des tests !
DATABASE_URL_TEST="postgresql://utilisateur:motdepasse@localhost:5432/quai19_test?schema=public"
# Base dédiée aux tests de bout en bout (npm run test:e2e) : elle est vidée à chaque lancement !
DATABASE_URL_E2E="postgresql://utilisateur:motdepasse@localhost:5432/quai19_e2e?schema=public"
